# CRAVORY BACKEND ENVIRONMENT CONFIGURATION (SAMPLE PLACEHOLDERS)
# Copy this file to .env and replace with actual credentials

PORT=4000
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/cravory?appName=Cluster0
JWT_SECRET=your_jwt_secret_key_here

# Razorpay Test Mode Credentials
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret_here
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here

# Cloudinary Configuration (Optional)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
